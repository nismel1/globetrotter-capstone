# Root environment template for Globetrotter
# Copy this file to .env and replace placeholders before running the app.

NODE_ENV=development

# Frontend
VITE_API_BASE_URL=http://localhost:4000
VITE_APP_NAME=Globetrotter

# Backend services
JWT_SECRET=replace_with_a_strong_random_secret
ALLOWED_ORIGINS=http://localhost:3200,http://localhost:5173
PEXELS_API_KEY=replace_with_pexels_key

# PostgreSQL
POSTGRES_USER=postgres
POSTGRES_PASSWORD=replace_with_strong_db_password
POSTGRES_DB=globetrotter

# OpenRouter / AI
OPENROUTER_API_KEY=replace_with_openrouter_key

# Clé partagée entre services internes (notification /internal/*)
INTERNAL_SERVICE_KEY=replace_with_a_strong_random_key

# RabbitMQ
RABBITMQ_USER=globetrotter
RABBITMQ_PASSWORD=replace_with_strong_broker_password

# Optional external services
OSRM_SERVICE_URL=http://osrm:5000
ELASTICSEARCH_URL=http://elasticsearch:9200
REDIS_URL=redis://redis:6379
